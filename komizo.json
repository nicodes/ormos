{
  "version": 1,
  "recipe": "go-cli",
  "repository": "nicodes/ormos",
  "tools": {
    "node": "24.18.1",
    "actionlint": "1.7.12",
    "shellcheck": "0.11.0"
  },
  "artifacts": [
    "dist"
  ],
  "build_environment": [
    "VERSION"
  ],
  "build_environment_defaults": {
    "VERSION": "dev"
  },
  "verification": {
    "version": 1,
    "full_targets": [
      "lint",
      "artifact-check",
      "test",
      "vuln",
      "e2e"
    ]
  },
  "tasks": {
    "web-check": [
      [
        "bash",
        "scripts/profile-web-check.sh"
      ]
    ],
    "browser-check": [
      [
        "bash",
        "scripts/profile-browser-check.sh"
      ]
    ],
    "platform-check": [
      [
        "bash",
        "scripts/profile-platform-check.sh"
      ]
    ],
    "lint-source": [
      [
        "bash",
        "scripts/profile-lint.sh"
      ]
    ]
  },
  "stages": {
    "install": [
      [
        "go",
        "mod",
        "download"
      ],
      [
        "npm",
        "ci",
        "--prefix",
        "ui"
      ]
    ],
    "lint": [
      [
        "bash",
        "scripts/profile-lint.sh"
      ],
      [
        "bash",
        "scripts/profile-web-check.sh"
      ],
      [
        "actionlint"
      ]
    ],
    "unit": [
      [
        "bash",
        "scripts/profile-test.sh"
      ]
    ],
    "build": [
      [
        "bash",
        "scripts/profile-build.sh"
      ]
    ],
    "e2e": [
      [
        "bash",
        "scripts/profile-browser-check.sh"
      ]
    ],
    "artifact-check": [
      [
        "bash",
        "scripts/profile-artifact-smoke.sh"
      ],
      [
        "bash",
        "scripts/profile-platform-check.sh"
      ]
    ],
    "dev": {
      "inapplicable": "Interactive CLI sessions require caller-owned terminal and configuration"
    },
    "stop": {
      "inapplicable": "The CLI owns no background development service"
    },
    "clean": [
      [
        "python3",
        "-c",
        "import shutil; [shutil.rmtree(p,ignore_errors=True) for p in (\"dist\",\".artifacts\",\"ui/node_modules\")]"
      ]
    ]
  },
  "validation": {
    "workflow": {
      "required": [
        "ci.yml",
        "dependency-policy.yml",
        "release.yml"
      ],
      "ci_gates": [
        "Test",
        "Test (macOS)"
      ]
    }
  }
}
